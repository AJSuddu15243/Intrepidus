{
  "name": "intrepidus",
  "version": "0.1.0",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx test/live.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "description": "Intrepidus: team-shared OptChat for Pi. Each teammate keeps their own endless chat; every teammate's agent can read, zoom into and search the others'. Fork of pi-optchat.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "optchat",
    "memory",
    "subagents",
    "team",
    "intrepidus"
  ],
  "author": "Ananth Jayakrishnan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJSuddu15243/Intrepidus.git"
  },
  "homepage": "https://github.com/AJSuddu15243/Intrepidus#readme",
  "bugs": {
    "url": "https://github.com/AJSuddu15243/Intrepidus/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
