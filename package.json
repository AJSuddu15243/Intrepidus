{
  "name": "pi-optchat",
  "version": "0.3.1",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./node_modules/pi-web-access/dist"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx test/live.ts"
  },
  "dependencies": {
    "pi-web-access": "0.35.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "description": "OptChat memory for Pi: persistent profiles, zoomable history, background agents, and conversation imports.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "optchat",
    "memory",
    "subagents"
  ],
  "author": "Jonas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonaslsaa/pi-optchat.git"
  },
  "homepage": "https://github.com/jonaslsaa/pi-optchat#readme",
  "bugs": {
    "url": "https://github.com/jonaslsaa/pi-optchat/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bundleDependencies": [
    "pi-web-access"
  ]
}
